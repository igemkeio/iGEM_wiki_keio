{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "test:check": "node --test \"scripts/lib/check/*.test.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "notion:sync": "node scripts/notion-sync.mjs",
    "fonts:subset": "node scripts/fonts-subset.mjs",
    "test:sync": "node --test \"scripts/lib/*.test.mjs\""
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@notionhq/client": "^2.2.15",
    "katex": "^0.18.9",
    "marked": "^18.0.5",
    "notion-to-md": "^3.1.9",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "subset-font": "^2.9.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^5.0.2"
  }
}

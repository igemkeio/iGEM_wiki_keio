{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p e2e",
    "check": "node scripts/check.mjs",
    "test:check": "node --test \"scripts/lib/check/*.test.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e",
    "test:e2e:ui": "playwright test -c e2e --ui",
    "notion:sync": "node scripts/notion-sync.mjs",
    "fonts:subset": "node scripts/fonts-subset.mjs",
    "test:sync": "node --test \"scripts/lib/*.test.mjs\"",
    "check:code": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install || echo \"lefthook install に失敗したため省きました(core.hooksPath が設定されている場合など)。web/README.md の pre-commit の節を参照\""
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@notionhq/client": "^2.2.15",
    "katex": "^0.18.9",
    "marked": "^18.0.5",
    "notion-to-md": "^3.1.9",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "happy-dom": "^20.14.5",
    "lefthook": "^2.1.15",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "subset-font": "^2.9.0",
    "typescript": "^5",
    "ultracite": "^7.12.2",
    "vite": "^7",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
